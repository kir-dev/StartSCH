<PostBase
    Post="@Post"
    CurrentInstant="@CurrentInstant"
    HideAdminControls="@HideAdminControls"
    EventKnown="@EventKnown"
    KnownPageId="@KnownPageId">
    <Content Context="textContent">
        <div style="max-height: 2lh; overflow-y: clip; color: var(--md-sys-color-on-surface-variant)">
            @((MarkupString)textContent.HtmlExcerpt)
        </div>
    </Content>
</PostBase>

@code {
    [Parameter, EditorRequired] public required Post Post { get; set; }
    [Parameter, EditorRequired] public required Instant CurrentInstant { get; set; }
    [Parameter] public bool HideAdminControls { get; set; }
    [Parameter] public bool EventKnown { get; set; }
    [Parameter] public int? KnownPageId { get; set; }
}
