@switch (Article)
{
    case Event e:
        <EventView Variant="@EventViewVariant.Preview" Event="@e" CurrentInstant="@CurrentInstant" HeadingLevel="@HeadingLevel">
            <ChildContent>
                <CardList>
                    <EventDescendants ChildEvents="@e.Children" Posts="@e.Posts" CurrentInstant="@CurrentInstant" HeadingLevel="@(HeadingLevel + 1)"/>
                </CardList>
            </ChildContent>
        </EventView>
        break;
    case Post p:
        <PostPreview Post="@p" EventKnown="@EventKnown" CurrentInstant="@CurrentInstant" HeadingLevel="@HeadingLevel"/>
        break;
    default:
        throw new InvalidOperationException();
}

@code {
    [Parameter, EditorRequired] public required IArticle Article { get; set; }
    [Parameter, EditorRequired] public required Instant CurrentInstant { get; set; }
    [Parameter, EditorRequired] public required int HeadingLevel { get; set; }
    [Parameter] public bool EventKnown { get; set; }
}
