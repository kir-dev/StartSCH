@using StartSch.Components.EmailTemplates
@{
    TextContent content = new(Post.ContentMarkdown ?? "", Post.ExcerptMarkdown);
}

@* Open Android notification *@
@if (Post.Published == null) // no notification when editing after publishing
{
    string from = string.Join(", ", Post.GetOwners().Select(p => p.GetName()));
    
    <AdminContentPreview Title="Android értesítés">
        <div style="
                background-color: var(--md-sys-color-surface-container-high);
                border-radius: 28px;
                padding: 52px 22px 52px 52px;
                max-width: 400px;
                ">
            <h4 class="typescale-title-medium" style="margin: 0 128px 8px 0; font-size: 18px">
                @(Post.Title)
            </h4>
            <p class="typescale-body-medium"
               style="
                    color: var(--md-sys-color-on-surface-variant);
                    white-space: pre-wrap;
                    margin: 4px 0 0 0;
                    max-height: 10lh;
                    overflow: hidden">(@from) @content.TextExcerpt</p>
        </div>
    </AdminContentPreview>

    <AdminContentPreview Title="Email">
        <div class="email-preview html-content">
            <h2 class="typescale-title-small" style="margin-top: 0">@Post.Title</h2>
            <p class="typescale-body-medium">
                <b>From:</b> @from @("<noreply-kirdev@sch.bme.hu>")
            </p>
            <hr style="margin: 16px -16px"/>
            <PostEmailTemplate Post="@Post"/>
        </div>
    </AdminContentPreview>
}

@* Home page post *@
<AdminContentPreview Title="StartSCH főoldal">
    <PostPreview Post="@Post" HideAdminControls="@true" CurrentInstant="@CurrentInstant" />
</AdminContentPreview>

@* Post page *@
<AdminContentPreview Title="StartSCH poszt oldal">
    <PostView Post="@Post" HideAdminControls="@true" CurrentInstant="@CurrentInstant" />
</AdminContentPreview>


@code {
    [Parameter, EditorRequired] public required Post Post { get; set; }
    [Parameter, EditorRequired] public required Instant CurrentInstant { get; set; }
}
