@foreach (object o in ChildEvents
     .Concat<object>(Posts)
     .OrderByDescending(o => o switch
     {
         Event e => e.Start,
         Post p => p.Created,
         _ => throw new InvalidOperationException()
     })
)
{
    var key = o switch
    {
        Event e => $"event{e.Id}",
        Post p => $"post{p.Id}",
        _ => throw new InvalidOperationException()
    };
    @switch (o)
    {
        case Event e:
            <EventBase @key="@key" Variant="@EventViewVariant.Preview" Event="@e" CurrentInstant="@CurrentInstant">
                <ChildContent>
                    <EventDescendants ChildEvents="@e.Children" Posts="@e.Posts" CurrentInstant="@CurrentInstant"/>
                </ChildContent>
            </EventBase>
            break;
        case Post p:
            <PostPreview @key="@key" Post="@p" EventKnown="@true" CurrentInstant="@CurrentInstant"/>
            break;
    }
}

@code {
    [Parameter, EditorRequired] public required List<Event> ChildEvents { get; set; }
    [Parameter, EditorRequired] public required List<Post> Posts { get; set; }
    [Parameter, EditorRequired] public required Instant CurrentInstant { get; set; }
}
