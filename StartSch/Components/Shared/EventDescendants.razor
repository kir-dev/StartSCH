@foreach (IArticle article in ChildEvents
     .Concat<IArticle>(Posts)
     .OrderByDescending(o => o switch
     {
         Event e => e.Start,
         Post p => p.Created,
         _ => throw new InvalidOperationException()
     })
)
{
    <ArticleTreeView @key="@article" Article="@article" CurrentInstant="@CurrentInstant" HeadingLevel="@HeadingLevel" EventKnown="@true"/>
}

@code {
    [Parameter, EditorRequired] public required List<Event> ChildEvents { get; set; }
    [Parameter, EditorRequired] public required List<Post> Posts { get; set; }
    [Parameter, EditorRequired] public required Instant CurrentInstant { get; set; }
    [Parameter, EditorRequired] public required int HeadingLevel { get; set; }

}
