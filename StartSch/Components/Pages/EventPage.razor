@page "/events/{EventId:int}"

@using System.Data
@using StartSch.Data.Queries
@using StartSch.Services

@inherits ResourcePage<Event>

@inject Db Db
@inject InterestService InterestService
@inject AuthorizationService AuthorizationService

@if (After != null)
{
    @if (_event != null)
    {
        <InfiniteList Items="@_rootArticles" NextLink="@_nextLink">
            <ItemTemplate Context="rootArticle">
                <ArticleTreeView @key="@rootArticle" Article="@rootArticle" CurrentInstant="@_currentInstant" HeadingLevel="3"
                                 EventKnown="@true"/>
            </ItemTemplate>
        </InfiniteList>
    }
}
else
{
    <LayoutView Layout="@typeof(MainLayout)">
        @if (!IsResourceAvailable(_event, AuthorizationService.CanRead, out var status))
        {
            <ResourceUnavailable Status="@status"/>
        }
        else
        {
            <PageTitle>@_event.Title | StartSCH</PageTitle>

            <CardList IsTopLevel>
                <EventAncestors Event="@_event" HeadingLevel="3" CurrentInstant="@_currentInstant">
                    <CardList>
                        <EventView Event="@_event" Variant="@EventViewVariant.View" CurrentInstant="@_currentInstant"
                                   HeadingLevel="1">
                            <ChildContent>
                                <h2 class="screen-reader-only">Alesemények és hírek</h2>
                                <CardList>
                                    <InfiniteList Items="@_rootArticles" NextLink="@_nextLink">
                                        <ItemTemplate Context="rootArticle">
                                            <ArticleTreeView @key="@rootArticle" Article="@rootArticle"
                                                             CurrentInstant="@_currentInstant" HeadingLevel="3"
                                                             EventKnown="@true"/>
                                        </ItemTemplate>
                                    </InfiniteList>
                                </CardList>
                            </ChildContent>
                        </EventView>
                    </CardList>

                    <h2 class="screen-reader-only">Főesemény</h2>
                </EventAncestors>
            </CardList>
        }
    </LayoutView>
}

@code {
    private Event? _event;
    private List<IArticle> _rootArticles = [];
    private string? _nextLink;
    private readonly Instant _currentInstant = SystemClock.Instance.GetCurrentInstant();

    [Parameter] public int EventId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "after")]
    public string? After { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await InterestService.LoadIndex;

        await using var tx = await Db.BeginTransaction(IsolationLevel.Snapshot);

        var ev = await Db.Events
            .Include(e => e.Parent)
            .Include(e => e.EventCategories)
            .FirstOrDefaultAsync(e => e.Id == EventId);

        // TODO: Per-article authorization
        if (ev == null || !AuthorizationService.CanRead(ev))
        {
            await tx.CommitAsync();
            return;
        }

        _event = ev;

        IQueryable<Event> rootEventsQuery = Db.Events
            .Where(e => e.ParentId == _event.Id);

        IQueryable<Post> rootPostsQuery = Db.Posts
            .Where(p => p.EventId == _event.Id);

        ArticlePage page = await ArticlePaging.LoadAsync(Db, rootEventsQuery, rootPostsQuery, Db.Posts, After);
        _rootArticles = page.Roots.ToList();
        _nextLink = page.NextCursor is { } cursor
            ? $"/events/{EventId}?after={Uri.EscapeDataString(cursor)}"
            : null;

        await tx.CommitAsync();
    }

}
