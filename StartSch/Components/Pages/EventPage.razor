@page "/events/{EventId:int}"

@using System.Data
@using StartSch.Services

@layout MainLayout
@inherits ResourcePage<Event>

@inject Db Db
@inject InterestService InterestService
@inject AuthorizationService AuthorizationService

@if (!IsResourceAvailable(_event, AuthorizationService.CanRead, out var status))
{
    <ResourceUnavailable Status="@status"/>
}
else
{
    <PageTitle>@_event.Title</PageTitle>

    <main>
        <EventAncestors Event="@_event" HeadingLevel="1" CurrentInstant="@_currentInstant"> @*TODO: Figure out what headings to use for parent events*@
            <EventBase Event="@_event" Variant="@EventViewVariant.View" CurrentInstant="@_currentInstant">
                <ChildContent>
                    <EventDescendants Posts="@_event.Posts" ChildEvents="@_event.Children" CurrentInstant="@_currentInstant" />
                </ChildContent>
            </EventBase>
        </EventAncestors>
    </main>
}

@code {
    private Event? _event;
    private readonly Instant _currentInstant = SystemClock.Instance.GetCurrentInstant();

    [Parameter] public int EventId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await InterestService.LoadIndex;

        await using var tx = await Db.BeginTransaction(IsolationLevel.Snapshot);

        _event = await Db.Events
            .Include(e => e.Parent)
            .Include(e => e.EventCategories)
            .FirstOrDefaultAsync(e => e.Id == EventId);
        StateHasChanged();

        if (_event == null)
        {
            await tx.CommitAsync();
            return;
        }

        await Db.Events
            .GetDescendants(_event.Id)
            .Include(e => e.EventCategories)
            .LoadAsync();
        StateHasChanged();

        await Db.Posts
            .GetPostsForEvent(_event.Id)
            .Include(p => p.PostCategories)
            .LoadAsync();
        StateHasChanged();

        await tx.CommitAsync();
    }

}
