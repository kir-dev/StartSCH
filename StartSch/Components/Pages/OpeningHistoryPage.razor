@page "/openings"

@using StartSch.Services

@layout MainLayout

@inject Db Db
@inject InterestService InterestService

<Title class="typescale-headline-medium" style="margin-bottom: 1rem">Nyitások</Title>

<CardList>
    @foreach (var opening in _openings)
    {
        <EventBase Event="@opening" Variant="@EventViewVariant.Preview" CurrentInstant="@_currentInstant" />
    }
</CardList>

@code {
    private List<PincerOpening> _openings = [];
    private readonly Instant _currentInstant = SystemClock.Instance.GetCurrentInstant();

    protected override async Task OnInitializedAsync()
    {
        await InterestService.LoadIndex;
        _openings = await Db.PincerOpenings
            .Where(o => o.End != null)
            .OrderByDescending(o => o.Start)
            .Include(o => o.EventCategories)
            .ToListAsync();
    }

}
