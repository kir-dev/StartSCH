@page "/posts/{id:int}"
@page "/posts/{id:int}-{slug}"

@using StartSch.Services

@layout DocumentLayout
@inherits ResourcePage<Post>

@inject Db Db
@inject InterestService InterestService
@inject AuthorizationService AuthorizationService

<MainGrid>
    <PrimaryContent>
        <main>
            @if (!IsResourceAvailable(_post, p => AuthorizationService.CanRead(p, _currentInstant), out var resourceUnavailabilityStatus))
            {
                <ResourceUnavailable Status="@resourceUnavailabilityStatus"/>
            }
            else
            {
                <PageTitle>@_post.Title | StartSCH</PageTitle>
                <CardList IsTopLevel>
                    <PostView Post="@_post" CurrentInstant="@_currentInstant" />
                </CardList>
            }
        </main>
    </PrimaryContent>
</MainGrid>

@code {
    private readonly Instant _currentInstant = SystemClock.Instance.GetCurrentInstant();
    private Post? _post;

    [Parameter] public int Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await InterestService.LoadIndex;
        _post = await Db.Posts
            .Include(p => p.PostCategories)
            .Include(p => p.Event)
            .FirstOrDefaultAsync(p => p.Id == Id);
    }

}
